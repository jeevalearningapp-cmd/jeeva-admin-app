run = "npm run dev"
modules = ["nodejs-20", "postgresql-16"]
hidden = [".config", "package-lock.json"]
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[unitTest]
language = "nodejs"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist"
run = ["npm", "run", "dev"]

[[ports]]
localPort = 3001
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5173

[[ports]]
localPort = 33541
externalPort = 3001

[[ports]]
localPort = 34525
externalPort = 5000

[[ports]]
localPort = 37233
externalPort = 3002

[[ports]]
localPort = 38889
externalPort = 6800

[[ports]]
localPort = 40051
externalPort = 3000

[[ports]]
localPort = 45731
externalPort = 6000

[[ports]]
localPort = 46713
externalPort = 4200

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
